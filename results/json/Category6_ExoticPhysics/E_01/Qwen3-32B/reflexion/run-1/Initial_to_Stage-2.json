      "code": "def build_agent(sandbox):\n    # Define beam parameters for minimal mass and axial load path\n    beam_width = 0.1  # m\n    beam_height = 0.2  # m\n    beam_area = beam_width * beam_height\n    beam_density = 0.02 / beam_area  # kg/m² for 0.02 kg total mass\n\n    # Place beam horizontally at the center of the build zone (x=20.0) near the floor (y=6.1)\n    beam_x = 20.0\n    beam_y = 6.1  # Just above build zone floor (y=6.0) to avoid obstacles\n\n    # Add the beam with correct mass and placement\n    beam = sandbox.add_beam(beam_x, beam_y, beam_width, beam_height, angle=0, density=beam_density)\n\n    # Anchor left end to the floor at the same x-coordinate\n    sandbox.add_joint(beam, None, (beam_x - beam_width / 2, beam_y), type='rigid')\n\n    # Anchor right end to the wall at x=28.0 (right boundary of build zone)\n    sandbox.add_joint(beam, None, (beam_x + beam_width / 2, beam_y), type='rigid')\n\n    return beam\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
