      "attempt": 6,
      "code": "def build_agent(sandbox):\n    # Define beam dimensions and density\n    BEAM_WIDTH = 0.2  # Vertical beams width (m)\n    BEAM_HEIGHT = 7.5  # Vertical beams height (m)\n    HORIZONTAL_WIDTH = 2.6  # Horizontal beams width (m)\n    HORIZONTAL_HEIGHT = 0.2  # Horizontal beams height (m)\n    DENSITY = 0.2  # kg/m³ (density for all beams)\n\n    # Left and right vertical beams, 1.3m from Core (x=10.0)\n    left_x = 8.7\n    right_x = 11.3\n    vertical_y = 3.75  # Center of vertical beams (y=0 to 7.5m)\n\n    # Add vertical beams\n    left_vertical = sandbox.add_beam(\n        x=left_x, y=vertical_y, width=BEAM_WIDTH, height=BEAM_HEIGHT, density=DENSITY\n    )\n    right_vertical = sandbox.add_beam(\n        x=right_x, y=vertical_y, width=BEAM_WIDTH, height=BEAM_HEIGHT, density=DENSITY\n    )\n\n    # Add horizontal beams at y=7.5, 5.0, 2.5, and 1.5\n    horizontal_beams = []\n    for y in [7.5, 5.0, 2.5, 1.5]:\n        beam = sandbox.add_beam(\n            x=10.0, y=y, width=HORIZONTAL_WIDTH, height=HORIZONTAL_HEIGHT, density=DENSITY\n        )\n        horizontal_beams.append(beam)\n\n    # Connect horizontal beams to vertical beams\n    for beam in horizontal_beams:\n        # Connect to left vertical beam at left end of horizontal beam\n        sandbox.add_joint(\n            beam, left_vertical, (left_x, beam.position[1]), type='rigid'\n        )\n        # Connect to right vertical beam at right end of horizontal beam\n        sandbox.add_joint(\n            beam, right_vertical, (right_x, beam.position[1]), type='rigid'\n        )\n\n    # Anchor vertical beams to ground\n    sandbox.add_joint(left_vertical, None, (left_x, 0.0), type='rigid')\n    sandbox.add_joint(right_vertical, None, (right_x, 0.0), type='rigid')\n\n    return left_vertical\n\ndef agent_action(sandbox, agent_body, step_count):\n    # No active control required; the structure is static and fully built\n    pass",
