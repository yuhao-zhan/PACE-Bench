      "code": "def build_agent(sandbox):\n    # Vertical beam parameters\n    vertical_x_left = 8.7\n    vertical_x_right = 11.3\n    vertical_y_center = 3.0\n    vertical_width = 0.1\n    vertical_height = 6.0\n    vertical_density = 0.1\n\n    # Add vertical beams\n    left_vertical = sandbox.add_beam(\n        x=vertical_x_left, y=vertical_y_center, width=vertical_width, height=vertical_height, density=vertical_density\n    )\n    right_vertical = sandbox.add_beam(\n        x=vertical_x_right, y=vertical_y_center, width=vertical_width, height=vertical_height, density=vertical_density\n    )\n\n    # Connect vertical beams to the ground\n    sandbox.add_joint(left_vertical, None, (vertical_x_left, 0.0), type='rigid')\n    sandbox.add_joint(right_vertical, None, (vertical_x_right, 0.0), type='rigid')\n\n    # Horizontal beam parameters\n    horizontal_width = 2.6\n    horizontal_height = 0.1\n    horizontal_density = 0.1\n\n    # Add horizontal beams at y = 7.5, 5.0, and 2.5\n    horizontal_beams = []\n    for y in [7.5, 5.0, 2.5]:\n        beam = sandbox.add_beam(\n            x=10.0, y=y, width=horizontal_width, height=horizontal_height, density=horizontal_density\n        )\n        horizontal_beams.append(beam)\n\n    # Connect horizontal beams to vertical beams at the top of the vertical beams\n    for beam in horizontal_beams:\n        sandbox.add_joint(\n            beam, left_vertical, (vertical_x_left, vertical_y_center + vertical_height / 2), type='rigid'\n        )\n        sandbox.add_joint(\n            beam, right_vertical, (vertical_x_right, vertical_y_center + vertical_height / 2), type='rigid'\n        )\n\n    return left_vertical\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
