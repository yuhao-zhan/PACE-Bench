      "code": "def build_agent(sandbox):\n    # Horizontal beam at y=3.0, centered at x=10.0, width=2.0m, height=0.1m, density=0.1 kg/m³\n    horizontal_beam = sandbox.add_beam(x=10.0, y=3.0, width=2.0, height=0.1, density=0.1)\n    \n    # Vertical beams at x=9.0, x=10.0, x=11.0, connected to the horizontal beam and ground\n    for x in [9.0, 10.0, 11.0]:\n        vertical_beam = sandbox.add_beam(x=x, y=3.0, width=0.1, height=0.1, density=0.1)\n        # Connect vertical beam to horizontal beam at (x, 3.0)\n        sandbox.add_joint(vertical_beam, horizontal_beam, (x, 3.0), type='rigid')\n        # Connect vertical beam to ground at (x, 0.0)\n        sandbox.add_joint(vertical_beam, None, (x, 0.0), type='rigid')\n    \n    return horizontal_beam\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
