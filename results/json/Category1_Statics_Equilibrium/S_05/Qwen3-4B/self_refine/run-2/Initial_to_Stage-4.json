      "code": "def build_agent(sandbox):\n    # Use very thin, low-density beams to stay within mass budget\n    # Columns at x=8.0 and x=12.0, y=2.0 with 0.1m width and 0.4m height\n    col_l = sandbox.add_beam(8.0, 2.0, 0.1, 0.4, angle=0, density=1.0)\n    col_r = sandbox.add_beam(12.0, 2.0, 0.1, 0.4, angle=0, density=1.0)\n    \n    # Connect columns to ground (y=0.0) with rigid joints\n    sandbox.add_joint(col_l, None, (8.0, 0.0), type='rigid')\n    sandbox.add_joint(col_r, None, (12.0, 0.0), type='rigid')\n    \n    # Roof beam with 1.0m width, 0.4m height to balance mass and coverage\n    roof = sandbox.add_beam(10.0, 4.2, 1.0, 0.4, angle=0, density=1.0)\n    \n    # Connect columns to roof at (8.0,4.0) and (12.0,4.0)\n    sandbox.add_joint(col_l, roof, (8.0, 4.0), type='rigid')\n    sandbox.add_joint(col_r, roof, (12.0, 4.0), type='rigid')\n    \n    return col_l\n\ndef agent_action(sandbox, agent_body, step_count):\n    # No need for control logic in this static structure\n    pass",
