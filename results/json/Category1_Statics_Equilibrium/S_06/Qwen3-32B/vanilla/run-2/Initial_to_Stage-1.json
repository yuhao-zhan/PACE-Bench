      "code": "def build_agent(sandbox):\n    n = 100\n    L = 1.0  # Block width\n    block_height = 0.2\n    total_mass = 35.0\n\n    # Compute harmonic number for n blocks\n    H_n = 0.0\n    for k in range(1, n + 1):\n        H_n += 1.0 / k\n\n    # Total overhang is (L/2) * H_n\n    total_overhang = (L / 2.0) * H_n\n    # Bottom block's center must be at x = -total_overhang to allow the top block's center at x = 0\n    x0 = -total_overhang\n\n    # Calculate the position of each block using the harmonic series\n    positions = [x0]\n    current_x = x0\n    for i in range(n - 1):\n        # Number of blocks above this one is (n - i - 1)\n        shift = L / (2.0 * (n - i))\n        current_x += shift\n        positions.append(current_x)\n\n    # Compute uniform density to stay within the mass budget\n    area_per_block = L * block_height\n    density = total_mass / (n * area_per_block)\n\n    # Add each block to the stack\n    for i in range(n):\n        y = 0.1 + i * block_height\n        x = positions[i]\n        sandbox.add_block(x, y, L, block_height, density=density)\n\n    return None\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass  # No active control needed; structure is passively stable",
