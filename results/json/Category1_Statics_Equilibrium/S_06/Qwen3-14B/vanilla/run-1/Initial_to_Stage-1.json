      "code": "def build_agent(sandbox):\n    # Calculate positions using harmonic series for maximum overhang with stability\n    # Each block's shift is width/(2*k) to ensure CoM of upper blocks is over the lower ones\n    n = 4  # Number of blocks needed to achieve 0.5m overhang within build constraints\n    block_width = 1.0\n    block_height = 0.2\n    total_area = n * block_width * block_height\n    max_mass = 35.0\n    density = max_mass / total_area  # Calculate density to meet mass budget\n    \n    # Initialize positions\n    x_positions = []\n    current_x = -0.5  # First block's center at table edge\n    x_positions.append(current_x)\n    \n    # Calculate positions for remaining blocks using harmonic series\n    for i in range(2, n+1):\n        shift = block_width / (2 * i)  # Harmonic series shift\n        current_x += shift\n        # Cap at build zone limit (x=0.0) to ensure stability\n        if current_x > 0.0:\n            current_x = 0.0\n        x_positions.append(current_x)\n    \n    # Add blocks to the simulation\n    for i in range(n):\n        x = x_positions[i]\n        y = 0.1 + i * block_height  # Stack vertically with 0.2m spacing\n        sandbox.add_block(x, y, block_width, block_height, density=density)\n    \n    return None\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
