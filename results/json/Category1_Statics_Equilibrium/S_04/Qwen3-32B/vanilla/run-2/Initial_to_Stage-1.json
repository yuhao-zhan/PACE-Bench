      "code": "import math\n\ndef build_agent(sandbox):\n    # Main beam connected via revolute joint to the pivot\n    main_beam = sandbox.add_beam(x=0.0, y=5.0, width=7.0, height=0.2, density=10.0)\n    sandbox.add_joint(main_beam, None, (0.0, 5.0), type=\"pivot\")  # Revolute joint for pivot\n\n    # Platform to hold the load\n    platform = sandbox.add_beam(x=3.0, y=5.5, width=1.0, height=0.2, density=10.0)\n    sandbox.add_joint(main_beam, platform, (3.0, 5.5), type=\"rigid\")\n\n    # Counterweight placed below the pivot for restoring torque\n    counterweight = sandbox.add_beam(x=-3.0, y=4.5, width=1.0, height=1.0, density=200.0)\n    sandbox.add_joint(main_beam, counterweight, (-3.0, 4.5), type=\"rigid\")\n\n    return main_beam\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
