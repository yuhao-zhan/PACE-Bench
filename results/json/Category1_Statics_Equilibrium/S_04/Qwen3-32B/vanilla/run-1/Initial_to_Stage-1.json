      "code": "import math\n\ndef build_agent(sandbox):\n    # Create the main horizontal beam with a revolute joint at the pivot\n    main_beam = sandbox.add_beam(x=0.0, y=5.0, width=7.0, height=0.2, density=10.0)\n    sandbox.add_joint(main_beam, None, (0.0, 5.0), type=\"pivot\")  # Revolute joint at pivot\n\n    # Create a platform to catch the load at x=3.0\n    platform = sandbox.add_beam(x=3.0, y=5.5, width=1.0, height=0.2, density=10.0)\n    sandbox.add_joint(main_beam, platform, (3.0, 5.5), type=\"rigid\")  # Rigid connection\n\n    # Add a counterweight to balance the load; place it lower to reduce the center of mass elevation\n    counterweight = sandbox.add_beam(x=-3.0, y=4.5, width=1.0, height=1.0, density=202.0)\n    sandbox.add_joint(main_beam, counterweight, (-3.0, 4.5), type=\"rigid\")  # Rigid connection\n\n    return main_beam\n\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass  # No active control is needed for a statically balanced system",
