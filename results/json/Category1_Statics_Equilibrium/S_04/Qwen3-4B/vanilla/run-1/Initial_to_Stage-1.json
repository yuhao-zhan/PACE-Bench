      "code": "import math\n\n\ndef build_agent(sandbox):\n    # Main beam: long and thin to provide a stable base\n    main_beam = sandbox.add_beam(x=0.0, y=5.0, width=7.0, height=0.2, density=10.0)\n    \n    # Connect main beam to pivot with a revolute joint (allows rotation)\n    sandbox.add_joint(main_beam, None, (0.0, 5.0), type=\"pivot\")\n    \n    # Platform: light beam at x=3.0 to catch the load\n    platform = sandbox.add_beam(x=3.0, y=5.5, width=1.0, height=0.2, density=10.0)\n    sandbox.add_joint(main_beam, platform, (3.0, 5.5), type=\"rigid\")\n    \n    # Counterweight: adjusted to balance torque and center of mass\n    # Positioned at (-3.0, 4.5) to balance vertical forces and torque\n    counterweight = sandbox.add_beam(x=-3.0, y=4.5, width=1.0, height=1.0, density=200.0)\n    sandbox.add_joint(main_beam, counterweight, (-3.0, 4.5), type=\"rigid\")\n    \n    return main_beam\n\n\ndef agent_action(sandbox, agent_body, step_count):\n    # No action needed as the structure is designed to balance dynamically\n    pass",
