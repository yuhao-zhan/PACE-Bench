      "code": "import math\n\n\ndef build_agent(sandbox):\n    # Adjusted structure to prevent grounding and balance torque\n    # Main beam is higher and narrower to reduce torque from its mass\n    main_beam = sandbox.add_beam(x=0.0, y=6.0, width=3.0, height=0.2, density=10.0)\n    sandbox.add_joint(main_beam, None, (0.0, 6.0), type=\"rigid\")\n    \n    # Platform at (3,5.5) to catch the load\n    platform = sandbox.add_beam(x=3.0, y=5.5, width=1.0, height=0.2, density=10.0)\n    sandbox.add_joint(main_beam, platform, (3.0, 5.5), type=\"rigid\")\n    \n    # Counterweight is heavier and positioned to balance torque\n    # Positioned at (-3,6.0) to increase counterweight torque\n    cw = sandbox.add_beam(x=-3.0, y=6.0, width=1.0, height=1.0, density=300.0)\n    sandbox.add_joint(main_beam, cw, (-3.0, 6.0), type=\"rigid\")\n    \n    return main_beam\n\n\ndef agent_action(sandbox, agent_body, step_count):\n    # No control logic needed for static balance; structure is designed to be stable\n    pass",
