      "code": "def build_agent(sandbox):\n    cabin = sandbox.get_vehicle_cabin()\n    if cabin is None:\n        raise ValueError(\"Cart not found\")\n    beams = []\n    # Add 5 beams with larger dimensions and higher density to increase mass\n    for (xx, yy) in [(4.8, 2.6), (4.9, 2.6), (5.0, 2.6), (5.1, 2.6), (5.2, 2.6)]:\n        b = sandbox.add_beam(xx, yy, 2.0, 0.2, angle=0, density=5.0)\n        sandbox.add_joint(cabin, b, (xx, yy), type=\"rigid\")\n        beams.append(b)\n    return cabin\n\n\ndef agent_action(sandbox, agent_body, step_count):\n    pos = sandbox.get_vehicle_position()\n    x, y = pos\n    vel = sandbox.get_vehicle_velocity()\n    vx, vy = vel\n\n    # Apply forward force in mud zone to counteract resistance\n    if 5.5 <= x <= 7.5:\n        sandbox.apply_force(agent_body, (500, 0))\n    # Apply forward force in first impulse zone to utilize impulse\n    elif 8.0 <= x <= 9.0:\n        sandbox.apply_force(agent_body, (1000, 0))\n    # Apply forward force in decel zone to maintain speed\n    elif 9.5 <= x <= 11.0:\n        sandbox.apply_force(agent_body, (200, 0))\n    # Apply backward force in brake zone to reduce final speed\n    elif 12.0 <= x <= 15.0:\n        sandbox.apply_force(agent_body, (-500, 0))",
