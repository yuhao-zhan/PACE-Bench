      "code": "def build_agent(sandbox):\n    cabin = sandbox.get_vehicle_cabin()\n    if cabin is None:\n        raise ValueError(\"Cart not found\")\n    beams = []\n    # Create 5 beams with larger dimensions and higher density to maximize mass within the budget\n    beam_positions = [\n        (4.8, 2.6), (4.9, 2.6), (5.0, 2.6), (5.1, 2.6), (5.0, 2.7)\n    ]\n    for (xx, yy) in beam_positions:\n        # Beam dimensions and density to achieve total mass ~14kg\n        b = sandbox.add_beam(xx, yy, 0.5, 0.5, angle=0, density=11.2)\n        sandbox.add_joint(cabin, b, (xx, yy), type=\"rigid\")\n        beams.append(b)\n    return cabin\n\n\ndef agent_action(sandbox, agent_body, step_count):\n    pos = sandbox.get_vehicle_position()\n    x = pos[0]\n    vel = sandbox.get_vehicle_velocity()\n    vx = vel[0]\n    \n    # Apply forces to manage speed through resistance zones\n    if 5.5 <= x <= 7.5:  # Mud zone: apply forward force to counteract resistance\n        sandbox.apply_force(agent_body, (200, 0))\n    elif 8.0 <= x <= 9.0:  # First impulse zone: boost speed to meet speed trap\n        sandbox.apply_force(agent_body, (300, 0))\n    elif 9.5 <= x <= 11.0:  # Decel zone: slow down to meet checkpoint speed\n        sandbox.apply_force(agent_body, (-150, 0))\n    elif 10.5 <= x <= 11.0:  # Second impulse zone: final acceleration before gates\n        sandbox.apply_force(agent_body, (250, 0))\n    elif 12.0 <= x <= 15.0:  # Brake zone: fine-tune final speed\n        sandbox.apply_force(agent_body, (-50, 0))\n    else:\n        pass",
