      "code": "import math\n\ndef build_agent(sandbox):\n    cabin = sandbox.get_vehicle_cabin()\n    if cabin is None:\n        raise ValueError(\"Cart not found\")\n    \n    # Use 5 beams to maximize structure mass (14.0 kg total), which helps maintain speed in damping zones\n    beams = []\n    beam_width = 0.08\n    beam_height = 2.0\n    beam_density = 17.5  # (14.0 kg) / (5 * 0.08 * 2.0 m²) = 17.5 kg/m³\n\n    # Attach five beams along the build zone (x = 4.8 to 5.2 m)\n    for xx in [4.8, 4.9, 5.0, 5.1, 5.2]:\n        beam = sandbox.add_beam(xx, 2.6, beam_width, beam_height, angle=0, density=beam_density)\n        sandbox.add_joint(cabin, beam, (xx, 2.6), type='rigid')\n        beams.append(beam)\n\n    return cabin\n\ndef agent_action(sandbox, agent_body, step_count):\n    pos = sandbox.get_vehicle_position()\n    x = pos[0]\n    vel = sandbox.get_vehicle_velocity()\n    vx = vel[0]\n\n    # Apply forward force until the first impulse zone to maintain speed through damping\n    if x < 9.0:\n        if vx < 5.0:  # Apply force if velocity is too low\n            sandbox.apply_force(agent_body, (250.0, 0.0))\n\n    # Apply strong forward impulse in the first zone to meet the speed trap at x=9 m\n    if 8.0 <= x < 9.0:\n        sandbox.apply_force(agent_body, (350.0, 0.0))\n\n    # Apply backward impulse in the second zone to meet the [1.1, 2.7] m/s checkpoint at x=11 m\n    if 10.5 <= x < 11.0:\n        sandbox.apply_force(agent_body, (-200.0, 0.0))\n\n    # After the checkpoint, apply a small backward impulse to reduce speed further for final target\n    if x >= 11.0:\n        sandbox.apply_force(agent_body, (-100.0, 0.0))",
