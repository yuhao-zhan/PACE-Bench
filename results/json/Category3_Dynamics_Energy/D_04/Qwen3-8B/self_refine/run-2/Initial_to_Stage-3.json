      "code": "def build_agent(sandbox):\n    # No structures are required for this task as it is purely a control problem\n    return None\n\ndef agent_action(sandbox, agent_body, step_count):\n    seat = sandbox.get_swing_seat()\n    if seat is None:\n        return\n    pos = seat.position\n    vel = seat.linearVelocity\n    vx = vel.x\n    vy = vel.y\n    target_y = 11.7\n    pivot_x = 10.0\n    pivot_y = 10.0\n\n    # Check if already in target zone\n    if pos.y >= target_y and 9.35 <= pos.x <= 10.65:\n        # Check apex or vertical fall\n        if abs(vx) < 1.0 and vy < 0:\n            # Apex\n            print(\"Target reached at apex\")\n            return  # Success\n        elif abs(vx) < 1.35 and vy <= 0:\n            # Vertical fall\n            print(\"Target reached via vertical fall\")\n            return  # Success\n        else:\n            # Not in target zone\n            pass\n\n    # Wind estimation (simplified)\n    # Assume wind direction is based on current velocity\n    # If velocity is positive, wind is pushing right; if negative, left\n    wind_direction = 1 if vx > 0 else -1\n\n    # Horizontal control\n    horizontal_error = pos.x - pivot_x\n    desired_direction = -1 if horizontal_error > 0 else 1\n    adjusted_desired_direction = desired_direction * wind_direction\n\n    # Apply horizontal impulse based on adjusted direction\n    if adjusted_desired_direction > 0:\n        # Rightward impulse to counteract wind\n        sandbox.apply_impulse_to_seat(4.2, 0)\n    elif adjusted_desired_direction < 0:\n        # Leftward impulse to counteract wind\n        sandbox.apply_impulse_to_seat(-4.2, 0)\n    else:\n        # No horizontal impulse needed\n        pass\n\n    # Vertical control\n    if pos.y < target_y:\n        # Apply upward impulse to increase vertical velocity\n        sandbox.apply_impulse_to_seat(0, 4.2)\n\n    return",
