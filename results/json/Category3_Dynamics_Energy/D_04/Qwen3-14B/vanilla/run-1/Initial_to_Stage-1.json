      "code": "def build_agent(sandbox):\n    # No structure is needed for this task as the original code succeeded without it.\n    # We can return None, or optionally build a small mass for stability, but it is not required.\n    return None\n\ndef agent_action(sandbox, agent_body, step_count):\n    seat = sandbox.get_swing_seat()\n    if seat is None:\n        return\n    pos = seat.position\n    vel = seat.linearVelocity\n    vx = vel.x\n    vy = vel.y\n    target_y = 11.7\n    force_mag = 42.0\n    impulse_mag = 4.2  # Max impulse per axis\n\n    if pos.y < target_y:\n        # Pumping logic: apply force in the direction of motion when moving away from the pivot\n        if (pos.x < 10.0 and vx > 0) or (pos.x > 10.0 and vx < 0):\n            sandbox.apply_force_to_seat(force_mag if vx > 0 else -force_mag, 0)\n        elif (pos.x < 10.0 and vx < 0) or (pos.x > 10.0 and vx > 0):\n            sandbox.apply_force_to_seat(-force_mag if pos.x < 10.0 else force_mag, 0)\n    else:\n        # Seat is above target y, try to counteract horizontal velocity\n        sandbox.apply_force_to_seat(-vx * 10.0, 0)\n\n        # Check for apex (vy ~ 0) and adjust x position\n        if abs(vy) < 0.1:\n            if pos.x < 9.35:\n                # Apply impulse to the right to bring x closer to target\n                sandbox.apply_impulse_to_seat(impulse_mag, 0)\n            elif pos.x > 10.65:\n                # Apply impulse to the left to bring x closer to target\n                sandbox.apply_impulse_to_seat(-impulse_mag, 0)",
