      "attempt": 3,
      "code": "def build_agent(sandbox):\n    # Base beam fixed to glass at center (6, 2)\n    base = sandbox.add_beam(x=6.0, y=2.0, width=0.5, height=0.5, density=1.0)\n    sandbox.weld_to_glass(base, anchor_point=(6.0, 2.0))\n    \n    # Create multiple beams for the wiper arm\n    wiper_beams = []\n    joints = []\n    # Add six beams connected in a line to span entire glass length (0 to 12m)\n    for i in range(6):\n        x = 1.0 + i * 2.0  # centers at 1.0, 3.0, 5.0, 7.0, 9.0, 11.0\n        beam = sandbox.add_beam(x=x, y=2.0, width=2.0, height=0.5, density=1.0)\n        wiper_beams.append(beam)\n        if i == 0:\n            # Connect to base\n            joint = sandbox.add_joint(body_a=base, body_b=beam, anchor_point=(x, 2.0), type='pivot')\n            joints.append(joint)\n        else:\n            # Connect to previous beam\n            prev_beam = wiper_beams[i-1]\n            joint = sandbox.add_joint(body_a=prev_beam, body_b=beam, anchor_point=(x, 2.0), type='pivot')\n            joints.append(joint)\n    \n    # Set motor on the first joint (base to first beam)\n    sandbox.set_motor(joints[0], motor_speed=-1.0, max_torque=1.0)\n    \n    # Set material properties for high friction\n    for body in [base] + wiper_beams:\n        sandbox.set_material_properties(body, restitution=0.0, friction=10.0)\n    \n    return base\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
