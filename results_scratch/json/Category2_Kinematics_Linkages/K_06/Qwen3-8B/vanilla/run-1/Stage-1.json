      "code": "def build_agent(sandbox):\n    # Base beam fixed to glass at center (6, 2)\n    base = sandbox.add_beam(x=6.0, y=2.0, width=0.5, height=0.5, density=1.0)\n    sandbox.weld_to_glass(base, anchor_point=(6.0, 2.0))\n    \n    # Wiper arm beam (horizontal, 2m wide for sweeping motion)\n    wiper = sandbox.add_beam(x=6.0, y=2.0, width=2.0, height=0.5, density=1.0)\n    \n    # Set material properties for effective particle pushing\n    sandbox.set_material_properties(base, restitution=0.0, friction=10.0)\n    sandbox.set_material_properties(wiper, restitution=0.0, friction=10.0)\n    \n    # Pivot joint between base and wiper arm at center (6, 2)\n    joint = sandbox.add_joint(body_a=base, body_b=wiper, anchor_point=(6.0, 2.0), type='pivot')\n    \n    # Continuous motor to drive sweeping motion\n    sandbox.set_motor(joint, motor_speed=-0.5, max_torque=1.0)\n    \n    return base\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
