      "code": "def build_agent(sandbox):\n    # Define beam dimensions and positions\n    # Horizontal beam at y=10, centered at (15, 10)\n    beam1 = sandbox.add_beam(x=15, y=10, width=0.1, height=0.1, density=1.0)\n    # Lower vertical beam at y=6, centered at (15, 6)\n    beam2 = sandbox.add_beam(x=15, y=6, width=0.1, height=0.1, density=1.0)\n    # Upper vertical beam at y=18, centered at (15, 18)\n    beam3 = sandbox.add_beam(x=15, y=18, width=0.1, height=0.1, density=1.0)\n    \n    # Add rigid joints to form a stable structure\n    # Joint between beam1 and beam2 at (15, 6)\n    joint1 = sandbox.add_joint(beam1, beam2, anchor_point=(15, 6), type='rigid')\n    # Joint between beam1 and beam3 at (15, 18)\n    joint2 = sandbox.add_joint(beam1, beam3, anchor_point=(15, 18), type='rigid')\n    # Joint between beam2 and floor at (15, 0)\n    joint3 = sandbox.add_joint(beam2, None, anchor_point=(15, 0), type='rigid')\n    # Joint between beam3 and ceiling at (15, 20)\n    joint4 = sandbox.add_joint(beam3, None, anchor_point=(15, 20), type='rigid')\n    \n    return beam1\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
