      "code": "def build_agent(sandbox):\n    # Define beam dimensions and positions\n    beam_width = 0.1\n    beam_height = 0.0765\n    beam_center_x = 15.0\n    beam_center_y = 6.0\n\n    # Beam 1: Horizontal beam anchored to floor and wall\n    beam1 = sandbox.add_beam(x=beam_center_x, y=beam_center_y, width=beam_width, height=beam_height)\n    # Anchor to floor at (beam_center_x - beam_width/2, beam_center_y - beam_height/2)\n    sandbox.add_joint(beam1, None, (beam_center_x - beam_width/2, beam_center_y - beam_height/2), type='rigid')\n    # Anchor to wall at (beam_center_x + beam_width/2, beam_center_y + beam_height/2)\n    sandbox.add_joint(beam1, None, (beam_center_x + beam_width/2, beam_center_y + beam_height/2), type='rigid')\n\n    # Beam 2: Vertical beam anchored to ceiling and wall\n    beam2 = sandbox.add_beam(x=beam_center_x, y=beam_center_y, width=beam_height, height=beam_width)\n    # Anchor to ceiling at (beam_center_x, beam_center_y + beam_width/2)\n    sandbox.add_joint(beam2, None, (beam_center_x, beam_center_y + beam_width/2), type='rigid')\n    # Anchor to wall at (beam_center_x, beam_center_y - beam_width/2)\n    sandbox.add_joint(beam2, None, (beam_center_x, beam_center_y - beam_width/2), type='rigid')\n\n    return beam1\n\ndef agent_action(sandbox, agent_body, step_count):\n    # No control logic needed for this static structure\n    pass",
