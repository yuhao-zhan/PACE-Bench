      "code": "def build_agent(sandbox):\n    # Vertical column: two beams connected and anchored to floor and ceiling\n    # Beam 1: from y=6 to 11, center at y=8.5\n    vertical_beam1 = sandbox.add_beam(x=20.0, y=8.5, width=0.1, height=5.0)\n    # Beam 2: from y=11 to 16, center at y=13.5\n    vertical_beam2 = sandbox.add_beam(x=20.0, y=13.5, width=0.1, height=5.0)\n    # Connect the vertical beams\n    sandbox.add_joint(vertical_beam1, vertical_beam2, (20.0, 11.0), type='rigid')\n    # Anchor to floor (y=0) and ceiling (y=20)\n    sandbox.add_joint(vertical_beam1, None, (20.0, 0.0), type='rigid')\n    sandbox.add_joint(vertical_beam2, None, (20.0, 20.0), type='rigid')\n    \n    # Horizontal beams connected to the vertical column\n    # Beam 3: horizontal beam at y=8.5, spanning from x=17.5 to 22.5\n    horizontal_beam1 = sandbox.add_beam(x=20.0, y=8.5, width=5.0, height=0.1)\n    sandbox.add_joint(horizontal_beam1, vertical_beam1, (20.0, 8.5), type='rigid')\n    # Beam 4: horizontal beam at y=13.5, spanning from x=17.5 to 22.5\n    horizontal_beam2 = sandbox.add_beam(x=20.0, y=13.5, width=5.0, height=0.1)\n    sandbox.add_joint(horizontal_beam2, vertical_beam2, (20.0, 13.5), type='rigid')\n    \n    return vertical_beam1\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass",
