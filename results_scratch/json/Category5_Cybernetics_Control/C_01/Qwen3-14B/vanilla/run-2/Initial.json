      "code": "def build_agent(sandbox):\n    # The cart and pole are pre-existing in the environment\n    # This function returns the cart body for reference\n    cart = sandbox.get_cart_body()\n    return cart\n\ndef agent_action(sandbox, agent_body, step_count):\n    # Access the true pole state directly from the physics engine\n    pole = sandbox.get_pole_body()\n    theta = pole.angle  # True pole angle in radians\n    omega = pole.angularVelocity  # True angular velocity in rad/s\n\n    # Get cart's position and track boundaries\n    x = agent_body.position.x\n    track_center = sandbox.TRACK_CENTER_X\n    safe_half_range = sandbox.SAFE_HALF_RANGE\n\n    # PD controller parameters (tuned for stability)\n    kp = 50.0  # Proportional gain for angle\n    kd = 5.0   # Derivative gain for angular velocity\n\n    # Calculate control force based on pole state\n    F = kp * theta + kd * omega\n\n    # Edge protection: Limit cart movement near track boundaries\n    margin = 0.5  # Safety margin from the edge\n    if x > track_center + safe_half_range - margin:\n        # Near right edge: apply force to move left\n        F = -100.0 * (x - (track_center + safe_half_range - margin))\n    elif x < track_center - safe_half_range + margin:\n        # Near left edge: apply force to move right\n        F = 100.0 * ((track_center - safe_half_range + margin) - x)\n\n    # Clamp force within actuator limits\n    F = max(min(F, 450), -450)\n\n    # Apply force to the cart\n    sandbox.apply_cart_force(F)",
