      "code": "def build_agent(sandbox):\n    # No additional bodies are needed; the pole and cart are already present\n    return sandbox.get_cart_body()\n\ndef agent_action(sandbox, agent_body, step_count):\n    # Retrieve pole angle and angular velocity (with sensor delays)\n    angle = sandbox.get_pole_angle()\n    omega = sandbox.get_pole_angular_velocity()\n    \n    # Retrieve cart position\n    cart_x = sandbox.get_cart_position()\n    \n    # PD controller gains (tuned for stability and response)\n    Kp = 10.0\n    Kd = 5.0\n    \n    # Compute force based on angle and angular velocity\n    force = Kp * angle + Kd * omega\n    \n    # Clamp force within actuator limits\n    force = max(-450.0, min(450.0, force))\n    \n    # Check for track boundaries and adjust force to prevent exit\n    track_center = sandbox.TRACK_CENTER_X\n    safe_half_range = sandbox.SAFE_HALF_RANGE\n    track_left = track_center - safe_half_range\n    track_right = track_center + safe_half_range\n    \n    # Apply a buffer zone to prevent overshooting\n    buffer = 0.5\n    if cart_x > track_right - buffer:\n        # If force is positive, reduce to zero to prevent exit\n        if force > 0:\n            force = 0.0\n    elif cart_x < track_left + buffer:\n        # If force is negative, reduce to zero to prevent exit\n        if force < 0:\n            force = 0.0\n    \n    # Apply the computed force to the cart\n    sandbox.apply_cart_force(force)",
