      "attempt": 1,
      "code": "def build_agent(sandbox):\n    # Return the cart body for the controller to access\n    return sandbox.get_cart_body()\n\ndef agent_action(sandbox, agent_body, step_count):\n    # Get current pole state\n    angle = sandbox.get_pole_angle()\n    omega = sandbox.get_pole_angular_velocity()\n    \n    # Get cart position and track limits\n    cart_pos = sandbox.get_cart_position()\n    track_center = sandbox.TRACK_CENTER_X\n    safe_half_range = sandbox.SAFE_HALF_RANGE\n    \n    # Calculate force using PD control (proportional + derivative)\n    # Tuned values for stability and response\n    k1 = 10.0  # Proportional gain for angle\n    k2 = 5.0   # Derivative gain for angular velocity\n    force = -k1 * angle - k2 * omega\n    \n    # Prevent cart from going out of bounds\n    max_pos = track_center + safe_half_range\n    min_pos = track_center - safe_half_range\n    \n    if cart_pos > max_pos - 0.5:\n        # Near right edge, apply zero force\n        force = 0.0\n    elif cart_pos < min_pos + 0.5:\n        # Near left edge, apply zero force\n        force = 0.0\n    \n    # Clamp force to actuator limits\n    force = max(-450.0, min(450.0, force))\n    \n    # Apply force to the cart\n    sandbox.apply_cart_force(force)",
