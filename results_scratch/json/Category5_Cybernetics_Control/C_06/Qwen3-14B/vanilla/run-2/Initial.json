      "code": "def build_agent(sandbox):\n    # Initialize control parameters\n    integral_error = 0.0\n    Kp = 5.0  # Proportional gain\n    Ki = 0.5  # Integral gain\n    return {'integral_error': integral_error, 'Kp': Kp, 'Ki': Ki}\n\ndef agent_action(sandbox, agent_body, step_count):\n    # Get current target speed and measured angular velocity\n    target_speed = sandbox.get_target_speed()\n    omega_measured = sandbox.get_wheel_angular_velocity()\n    \n    # Calculate torque limit based on measured speed\n    if omega_measured < 3.0:\n        torque_limit = 3.5 + 15.5 * omega_measured\n    else:\n        torque_limit = 3.5 + 15.5 * 3.0\n    \n    # Compute error and update integral term\n    error = target_speed - omega_measured\n    dt = 0.016667  # Time step\n    agent_body['integral_error'] += error * dt\n    \n    # Compute control torque\n    proportional = agent_body['Kp'] * error\n    integral = agent_body['Ki'] * agent_body['integral_error']\n    torque = proportional + integral\n    \n    # Apply deadzone and torque limits\n    deadzone = 2.0\n    if abs(torque) < deadzone:\n        if error > 0:\n            torque = deadzone\n        elif error < 0:\n            torque = -deadzone\n        else:\n            torque = 0.0\n    else:\n        torque = max(min(torque, torque_limit), -torque_limit)\n    \n    # Apply motor torque\n    sandbox.apply_motor_torque(torque)",
