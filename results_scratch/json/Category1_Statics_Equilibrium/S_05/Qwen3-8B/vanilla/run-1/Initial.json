      "code": "def build_agent(sandbox):\n    # Horizontal beam at y=7.5m, centered at x=10.0, width=2.0m, height=0.5m, density=50 kg/m³\n    horizontal_beam = sandbox.add_beam(x=10.0, y=7.5, width=2.0, height=0.5, density=50.0)\n\n    # Left vertical beam: centered at (8.0, 7.5), height=5.0m, width=0.5m, density=50 kg/m³\n    vertical_beam_left = sandbox.add_beam(x=8.0, y=7.5, width=0.5, height=5.0, density=50.0)\n    # Connect vertical beam to horizontal beam at (8.0, 7.5)\n    joint_left = sandbox.add_joint(horizontal_beam, vertical_beam_left, anchor=(8.0, 7.5), type='rigid')\n    # Connect vertical beam to ground at (8.0, 5.0)\n    joint_ground_left = sandbox.add_joint(vertical_beam_left, None, anchor=(8.0, 5.0), type='rigid')\n\n    # Right vertical beam: centered at (12.0, 7.5), height=5.0m, width=0.5m, density=50 kg/m³\n    vertical_beam_right = sandbox.add_beam(x=12.0, y=7.5, width=0.5, height=5.0, density=50.0)\n    # Connect vertical beam to horizontal beam at (12.0, 7.5)\n    joint_right = sandbox.add_joint(horizontal_beam, vertical_beam_right, anchor=(12.0, 7.5), type='rigid')\n    # Connect vertical beam to ground at (12.0, 5.0)\n    joint_ground_right = sandbox.add_joint(vertical_beam_right, None, anchor=(12.0, 5.0), type='rigid')\n\n    # Check total mass\n    total_mass = sandbox.get_structure_mass()\n    print(f\"Total structure mass: {total_mass} kg\")\n\n    return horizontal_beam\n\ndef agent_action(sandbox, agent_body, step_count):\n    # No active control needed; structure is static and passive.\n    pass",
