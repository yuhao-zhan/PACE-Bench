      "attempt": 1,
      "code": "def build_agent(sandbox):\n    foundation = sandbox.get_foundation()\n    \n    # Create base beam with width 10m and height 2m\n    base_beam = sandbox.add_beam(x=0.0, y=0.0, width=10.0, height=2.0)\n    \n    # Connect base to foundation with rigid joint and spring for damping\n    sandbox.add_joint(foundation, base_beam, (0.0, 0.0), type='rigid')\n    spring = sandbox.add_spring(foundation, base_beam, (0.0, 0.0), (0.0, 0.0), stiffness=15.0, damping=0.8)\n    \n    # Build up the tower with 10 levels, each 3m high\n    current_y = 2.0  # Start at top of base beam\n    height_per_level = 3.0\n    num_levels = 10  # Total height: 2 + 10*3 = 32m\n    prev_beam = base_beam\n    \n    for i in range(num_levels):\n        # Create horizontal beam\n        beam = sandbox.add_beam(x=0.0, y=current_y + height_per_level / 2, width=10.0, height=height_per_level)\n        \n        # Connect to previous beam with rigid joint\n        sandbox.add_joint(prev_beam, beam, (0.0, current_y + height_per_level / 2), type='rigid')\n        \n        prev_beam = beam\n        current_y += height_per_level\n    \n    return prev_beam\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass  # No active control needed; structure is passive and designed for stability",
