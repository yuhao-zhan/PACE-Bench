      "code": "def build_agent(sandbox):\n    foundation = sandbox.get_foundation()\n    \n    # Create base beam with width 8.0m (4.0m from center, 0.5m buffer for seismic movement)\n    base_beam = sandbox.add_beam(x=0.0, y=0.0, width=8.0, height=2.0)\n    \n    # Connect base to foundation with rigid joint and spring for seismic damping\n    sandbox.add_joint(foundation, base_beam, (0.0, 0.0), type='rigid')\n    spring = sandbox.add_spring(foundation, base_beam, (0.0, 0.0), (0.0, 0.0), stiffness=15.0, damping=0.8)\n    \n    # Add cross-bracing at lower levels for lateral stability\n    # First horizontal brace between base and first vertical beam\n    brace_y = 2.0 + 3.0 / 2  # Midpoint of first vertical beam\n    brace_beam = sandbox.add_beam(x=0.0, y=brace_y, width=8.0, height=0.5)\n    sandbox.add_joint(base_beam, brace_beam, (0.0, brace_y), type='rigid')\n    \n    # Build vertical tower with 10 levels of 3.0m height each (total height = 2.0 + 10*3.0 = 32.0m)\n    current_y = 2.0  # Start at top of base beam\n    height_per_level = 3.0\n    num_levels = 10\n    prev_beam = base_beam\n    \n    for i in range(num_levels):\n        beam = sandbox.add_beam(x=0.0, y=current_y + height_per_level / 2, width=8.0, height=height_per_level)\n        \n        # Connect to previous beam with rigid joint\n        sandbox.add_joint(prev_beam, beam, (0.0, current_y + height_per_level / 2), type='rigid')\n        \n        # Add cross-bracing at every other level for additional lateral stability\n        if i % 2 == 0:\n            brace_y = current_y + height_per_level / 2 + height_per_level / 2\n            brace_beam = sandbox.add_beam(x=0.0, y=brace_y, width=8.0, height=0.5)\n            sandbox.add_joint(beam, brace_beam, (0.0, brace_y), type='rigid')\n        \n        prev_beam = beam\n        current_y += height_per_level\n    \n    return prev_beam\n\ndef agent_action(sandbox, agent_body, step_count):\n    pass  # Structure is passive and designed for stability; no active control needed",
