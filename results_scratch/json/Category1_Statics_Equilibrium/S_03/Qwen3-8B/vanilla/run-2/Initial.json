      "code": "def build_agent(sandbox):\n    # Create main beam (12m long, 0.5m width, 2m height, density 750 kg/m³)\n    main_beam = sandbox.add_beam(x=6, y=0, width=0.5, height=2, angle=0, density=750)\n    # Create support beam (6m long, 0.5m width, 2m height, density 750 kg/m³)\n    support_beam = sandbox.add_beam(x=3, y=0, width=0.5, height=2, angle=0, density=750)\n    # Connect support beam to main beam at x=6m (center of main beam)\n    sandbox.add_joint(support_beam, main_beam, (6, 0), type='rigid')\n    # Anchor main beam to wall at x=0\n    sandbox.add_joint(main_beam, None, (0, 0), type='rigid')\n    return main_beam\n\ndef agent_action(sandbox, agent_body, step_count):\n    # Add first payload (500kg) at tip (x=12m) at t=5\n    if step_count == 5:\n        payload1 = sandbox.add_beam(x=12, y=0, width=1, height=0.5, angle=0, density=1000)\n        sandbox.add_joint(payload1, agent_body, (12, 0), type='rigid')\n    # Add second payload (500kg) at mid-span (x=6m) at t=15\n    elif step_count == 15:\n        payload2 = sandbox.add_beam(x=6, y=0, width=1, height=0.5, angle=0, density=1000)\n        sandbox.add_joint(payload2, agent_body, (6, 0), type='rigid')\n    return",
